# ===================================================================
# Firebase Client SDK Configuration (Vite exposes VITE_ prefixed vars)
# Replace placeholders with your actual Firebase project credentials.
# ===================================================================
VITE_FIREBASE_API_KEY=PLACEHOLDER_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=PLACEHOLDER_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PLACEHOLDER_PROJECT
VITE_FIREBASE_STORAGE_BUCKET=PLACEHOLDER_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PLACEHOLDER_SENDER_ID
VITE_FIREBASE_APP_ID=PLACEHOLDER_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=PLACEHOLDER_MEASUREMENT_ID

# ===================================================================
# Firebase Admin / Functions Configuration
# Used by Firebase Cloud Functions and server-side code
# ===================================================================
FIREBASE_PROJECT_ID=PLACEHOLDER_PROJECT
FIREBASE_CLIENT_EMAIL=PLACEHOLDER_PROJECT@PLACEHOLDER_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_PRIVATE_KEY\n-----END PRIVATE KEY-----\n

# ===================================================================
# Firebase Functions Region
# ===================================================================
FUNCTIONS_REGION=asia-south1

# ===================================================================
# Razorpay Payment Gateway (Test Keys by default)
# ===================================================================
VITE_RAZORPAY_KEY_ID=rzp_test_PLACEHOLDER_KEY_ID
RAZORPAY_KEY_SECRET=PLACEHOLDER_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=PLACEHOLDER_WEBHOOK_SECRET

# ===================================================================
# Google Calendar API (for Google Meet scheduling)
# ===================================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=PLACEHOLDER_PROJECT@PLACEHOLDER_PROJECT.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nPLACEHOLDER_PRIVATE_KEY\n-----END PRIVATE KEY-----\n
GOOGLE_CALENDAR_ID=primary

# ===================================================================
# WhatsApp Business API (Meta Cloud API)
# ===================================================================
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=PLACEHOLDER_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=PLACEHOLDER_BUSINESS_ACCOUNT_ID
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER_ACCESS_TOKEN

# ===================================================================
# Email Service (SMTP / SendGrid for transactional emails)
# ===================================================================
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=PLACEHOLDER_SENDGRID_API_KEY
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ===================================================================
# Application URLs
# ===================================================================
VITE_APP_URL=https://jadmaa.com
VITE_API_BASE_URL=https://asia-south1-PLACEHOLDER_PROJECT.cloudfunctions.net
