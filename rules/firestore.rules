rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Helper: Check if user is authenticated
    // ================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // ================================================================
    // Helper: Get the requesting user's document from Firestore
    // Returns the user's role or null
    // ================================================================
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isInstructor() {
      return isAuthenticated() && getUserRole() == 'instructor';
    }

    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    function isAdminOrInstructor() {
      return isAdmin() || isInstructor();
    }

    // ================================================================
    // Users Collection
    // ================================================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all profiles
      // Instructors can read student profiles (for grading)
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin() || isInstructor());

      // Users can create their own profile on signup
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Users can update their own profile (limited fields)
      // Admins can update any user (including role promotion)
      allow update: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ================================================================
    // Courses Collection (public catalog)
    // ================================================================
    match /courses/{courseId} {
      // Anyone can read course catalog (public listing)
      allow read: if true;

      // Only admins and instructors can create/update/delete courses
      allow create, update, delete: if isAdminOrInstructor();

      // Module sub-collection — same rules as parent course
      match /modules/{moduleId} {
        allow read: if true;
        allow create, update, delete: if isAdminOrInstructor();

        match /lessons/{lessonId} {
          allow read: if true;
          allow create, update, delete: if isAdminOrInstructor();
        }
      }
    }

    // ================================================================
    // Enrollments Collection (one document per student-course pair)
    // ================================================================
    match /enrollments/{enrollmentId} {
      // A student can read their own enrollments
      // Instructors and admins can read all enrollments for their courses
      allow read: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid ||
          isAdmin() || isInstructor());

      // A student can create an enrollment (self-enroll)
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid;

      // A student can update their own enrollment (progress)
      // Admins can update any enrollment
      allow update: if isAuthenticated() &&
        (resource.data.studentId == request.auth.uid || isAdmin());

      // Only admins can delete enrollments (instructor can't remove students)
      allow delete: if isAdmin();

      // Progress sub-collection
      match /progress/{lessonId} {
        allow read, create, update: if isAuthenticated() &&
          (resource.data.studentId == request.auth.uid ||
            get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.studentId == request.auth.uid ||
            isAdmin());
        allow delete: if isAdmin();
      }
    }

    // ================================================================
    // Lessons Progress Collection (alternative flat structure)
    // ================================================================
    match /lessonProgress/{progressId} {
      // Users can read their own progress
      allow read, create, update: if isAuthenticated() &&
        request.auth.uid == resource.data.userId;

      // Admins can read all progress
      allow read: if isAdmin();

      allow delete: if isAdmin();
    }

    // ================================================================
    // Live Classes Collection
    // ================================================================
    match /liveClasses/{liveClassId} {
      // Anyone authenticated can read live classes (to join)
      allow read: if isAuthenticated();

      // Only instructors and admins can create/update/delete
      allow create, update, delete: if isAdminOrInstructor();
    }

    // ================================================================
    // Certificates Collection
    // ================================================================
    match /certificates/{certificateId} {
      // Anyone authenticated can read certificates
      allow read: if isAuthenticated();

      // Only admins and instructors can create certificates
      allow create, update: if isAdminOrInstructor();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ================================================================
    // Payments Collection
    // ================================================================
    match /payments/{paymentId} {
      // Users can read their own payments
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Only the system (via Cloud Functions) can create/update payments
      // Admin can read all
      allow read: if isAdmin();

      allow create: if false; // Write-only via Callable Functions
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ================================================================
    // Contact Enquiries Collection
    // ================================================================
    match /contactEnquiries/{enquiryId} {
      // Users can read their own enquiries (if authenticated)
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Anyone can create a contact enquiry (public contact form)
      allow create: if true;

      // Admins and instructors can read all enquiries
      allow read: if isAdminOrInstructor();

      // Only admins can update/delete
      allow update, delete: if isAdmin();
    }

    // ================================================================
    // WhatsApp Templates Collection (for message tracking)
    // ================================================================
    match /whatsappMessages/{messageId} {
      // Only authenticated admins can read
      allow read: if isAdmin();

      // Only the system (via Cloud Functions) can create
      allow create: if false;

      allow update, delete: if isAdmin();
    }

    // ================================================================
    // Demo Requests Collection
    // ================================================================
    match /demoRequests/{requestId} {
      // Anyone can create a demo request
      allow create: if true;

      // Users can read their own, admin can read all
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }
  }
}
